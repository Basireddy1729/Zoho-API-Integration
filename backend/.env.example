# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (SQLite for local/demo use; swap for a postgresql:// or mysql:// URL in prod)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Zoho OAuth (service/backend account — created once via https://api-console.zoho.com)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:4000/api/zoho/oauth/callback
# Must match your Zoho account's data center: accounts.zoho.com (US), accounts.zoho.in (India),
# accounts.zoho.eu (Europe), accounts.zoho.com.cn (China), accounts.zoho.jp (Japan). Using the
# wrong one causes a generic "invalid_client" error even with correct ID/secret.
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
